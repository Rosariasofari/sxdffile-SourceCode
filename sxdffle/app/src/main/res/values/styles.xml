<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SXDffle 控制条胶囊按钮样式（保留，供其它场景使用） -->
    <style name="SxdffleChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">#FFE0E0E0</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 下拉菜单：分组标题 -->
    <style name="SxdffleMenuSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">#FF6E6E6E</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- 下拉菜单：菜单项 -->
    <style name="SxdffleMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">#FFE8E8E8</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
</resources>
