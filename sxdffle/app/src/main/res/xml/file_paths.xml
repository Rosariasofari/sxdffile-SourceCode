<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 路径配置：用于把应用内日志文件分享出去
  （微信 / QQ / 邮件 / 文件管理器 等）。
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- getExternalFilesDir(null) 对应 Android/data/<包名>/files -->
    <external-files-path
        name="sxdffle_logs"
        path="." />
    <!-- cacheDir：导出的日志 zip 先落在这里，再复制到公共下载目录 -->
    <cache-path
        name="sxdffle_cache"
        path="." />
    <!-- 内部存储兜底 -->
    <files-path
        name="sxdffle_internal"
        path="." />
</paths>
